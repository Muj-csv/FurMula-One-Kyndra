<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#ffffff">
<title>Kyndra — Transparent Animal Matching</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">
<style>
/* ==========================================================
   KYNDRA — "Warm Evidence" design system
   One coherent layer. No claymorphism, no !important wars.
   Terracotta is the brand color. Green and near-black ink are
   semantic-only (matched / eliminated) — never decorative.
   ========================================================== */
:root{
  --ink:#1D1812;
  --ink-soft:#6E5A46;
  --ink-faint:#A08E76;
  --paper:#FFFFFF;
  --paper-warm:#F1E2C4;
  --surface:#FFFCF6;
  --line:#DCC79A;
  --terracotta:#D95F3A;
  --terracotta-strong:#B94729;
  --terracotta-tint:#FBEAE1;
  --verified:#3B6B45;
  --verified-tint:#E7EFE3;
  --eliminated:#1D1812;
  --eliminated-tint:#ECEAE5;
  --radius:10px;
  --radius-sm:6px;
  --shadow-modal:0 24px 64px rgba(36,35,31,.22);
  --font-display:'Plus Jakarta Sans', system-ui, sans-serif;
  --font-body:'Plus Jakarta Sans', system-ui, sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0; color:var(--ink); background:var(--paper);
  font-family:var(--font-body);
  -webkit-font-smoothing:antialiased;
}
.tnum{font-variant-numeric:tabular-nums}
button,a,select,input{font:inherit; color:inherit}
a{text-decoration:none}
button{border:0; background:none; cursor:pointer}
h1,h2,h3,h4{margin:0; font-family:var(--font-display); font-weight:700; letter-spacing:-.02em; color:var(--ink)}
p{margin:0}

/* ---------- Nav ---------- */
.top-nav{
  position:sticky; top:0; z-index:30; background:rgba(255,255,255,.92); backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line);
  display:flex; align-items:center; gap:26px; padding:16px max(20px,calc((100vw - 1180px)/2));
}
.nav-logo{display:flex; align-items:center; gap:9px; font-family:var(--font-display); font-weight:700; font-size:1.28rem; letter-spacing:-.02em; color:var(--ink); transition:transform .12s}
.nav-logo:active{transform:scale(.97)}
.logo-mark{width:30px;height:30px; flex-shrink:0;}
.nav-links{display:flex; gap:4px; flex:1; justify-content:center}
.nav-link{padding:9px 13px; border-radius:var(--radius-sm); color:var(--ink-soft); font-size:.92rem; font-weight:600; position:relative; transition:color .2s ease, transform .12s}
.nav-link:not(.quiz-link)::after{content:"";position:absolute;left:13px;right:13px;bottom:2px;height:2px;background:var(--terracotta); opacity:0; transform:scaleX(0); transform-origin:center; transition:transform .25s cubic-bezier(.22,1,.36,1), opacity .25s ease}
.nav-link:hover{color:var(--ink)}
.nav-link:hover:not(.quiz-link)::after{opacity:1; transform:scaleX(1)}
.nav-link:active{transform:scale(.97)}
.nav-link.active{color:var(--ink)}
.nav-link.active:not(.quiz-link)::after{opacity:1; transform:scaleX(1)}
.nav-actions{display:flex; gap:8px; align-items:center}
.quiz-link{background:var(--terracotta); color:#fff!important; padding:10px 16px; border-radius:var(--radius-sm); font-weight:700; transition:background .2s ease, transform .12s}
.quiz-link:hover{background:var(--terracotta-strong)}
.quiz-link:active{transform:scale(.97)}

main{width:min(1180px,calc(100% - 40px)); margin:0 auto 90px}

/* ---------- Hero ---------- */
.hero{
  width:100%; margin:0 auto; padding:54px max(20px,calc((100vw - 1180px)/2)) 50px;
  border-bottom:1px solid var(--line);
}
.hero-inner{
  width:min(1180px,100%); margin:0 auto; display:grid;
  grid-template-columns:minmax(0,1.08fr) minmax(300px,.72fr);
  gap:clamp(34px,6vw,78px); align-items:center;
}
.hero-copy-block{min-width:0; text-align:left; padding:12px 0 8px}
.eyebrow{
  display:inline-flex; align-items:center; gap:8px; font-weight:700; font-size:.78rem; letter-spacing:.09em;
  text-transform:uppercase; color:var(--terracotta-strong); margin-bottom:18px;
}
.eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--terracotta)}
h1{max-width:720px; margin:0 0 20px; font-size:clamp(2.6rem,5.2vw,4.35rem); line-height:1.03; font-weight:800; letter-spacing:-.03em; font-style:normal}
h1 em{font-style:normal; color:var(--terracotta-strong); font-weight:800}
.hero-copy{max-width:610px; margin:0; color:var(--ink-soft); font-size:1.08rem; line-height:1.6; font-weight:500}
.hero-actions{display:flex; justify-content:flex-start; gap:12px; margin:30px 0 0; flex-wrap:wrap}
.hero-dog{
  position:relative; width:100%; max-width:370px; justify-self:end;
  aspect-ratio:512 / 910; min-height:390px; max-height:510px;
  overflow:hidden; border-radius:18px; background:var(--paper-warm);
  border:1px solid var(--line); box-shadow:0 18px 45px -28px rgba(29,24,18,.35);
  isolation:isolate;
}
.hero-dog::after{
  content:""; position:absolute; inset:0; pointer-events:none; z-index:2;
  background:linear-gradient(180deg,rgba(29,24,18,.06),transparent 28%,transparent 72%,rgba(29,24,18,.16));
}
.hero-dog video{
  display:block; width:100%; height:100%; object-fit:cover; object-position:center;
  pointer-events:none; user-select:none;
}
.hero-dog-label{
  position:absolute; z-index:3; left:16px; bottom:15px; padding:8px 11px;
  border-radius:999px; background:rgba(255,252,246,.9); border:1px solid rgba(220,199,154,.9);
  color:var(--ink); font-size:.72rem; font-weight:700; letter-spacing:.01em;
  backdrop-filter:blur(8px);
}
.primary,.secondary{padding:14px 24px; border-radius:var(--radius-sm); font-weight:700; font-size:.95rem; transition:transform .12s}
.primary{background:var(--terracotta); color:#fff}
.primary:hover{background:var(--terracotta-strong)}
.secondary{background:var(--paper); border:1.5px solid var(--line); color:var(--ink)}
.secondary:hover{border-color:var(--ink-faint)}
.primary:active,.secondary:active{transform:scale(.97)}

/* ---------- Section head ---------- */
.section-head{display:flex; justify-content:space-between; align-items:flex-end; gap:20px; margin:52px 0 24px; padding-bottom:20px; border-bottom:1px solid var(--line)}
.section-head h2{font-size:clamp(1.7rem,3vw,2.3rem)}
.section-head p{color:var(--ink-soft); margin-top:8px; font-size:.98rem; max-width:46ch}
.proof{padding:9px 14px; border:1px solid var(--line); border-radius:999px; color:var(--verified); font-weight:700; font-size:.8rem; white-space:nowrap; display:flex; align-items:center; gap:7px}
.proof::before{content:"✓"}

/* ---------- Filters ---------- */
.filters{display:flex; gap:8px; flex-wrap:wrap; margin-bottom:26px}
.filter-btn{padding:9px 15px; border-radius:999px; border:1px solid var(--line); color:var(--ink-soft); font-weight:600; font-size:.86rem}
.filter-btn.active{background:var(--ink); border-color:var(--ink); color:#fff}
.filter-btn:hover:not(.active){border-color:var(--ink-faint); color:var(--ink)}

/* ---------- Companion grid ---------- */
.companion-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px}
.companion-card{border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; background:var(--paper); transition:border-color .35s cubic-bezier(.22,1,.36,1), transform .35s cubic-bezier(.22,1,.36,1), box-shadow .35s cubic-bezier(.22,1,.36,1)}
.companion-card:hover{border-color:var(--terracotta); transform:translateY(-4px); box-shadow:0 14px 30px -12px rgba(217,95,58,.35)}
.card-image-wrapper{position:relative; height:180px; background:var(--paper-warm); overflow:hidden; border-bottom:1px solid var(--line); transition:border-color .35s cubic-bezier(.22,1,.36,1)}
.companion-card:hover .card-image-wrapper{border-bottom-color:var(--terracotta-tint)}
.card-photo{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .5s cubic-bezier(.22,1,.36,1)}
.companion-card:hover .card-photo{transform:scale(1.06)}
.photo-credit{position:absolute; right:9px; bottom:9px; z-index:2; padding:4px 8px; border-radius:999px; background:rgba(36,35,31,.55); color:#fff; font-size:.62rem; font-weight:600; letter-spacing:.01em}
.status-tag{position:absolute; left:12px; top:12px; background:var(--ink); color:#fff; font-size:.72rem; font-weight:700; padding:6px 10px; border-radius:5px}
.status-tag.long{background:var(--terracotta)}
.card-content{padding:16px 18px 18px}
.card-header{display:flex; justify-content:space-between; align-items:baseline; gap:8px}
.pet-name{font-size:1.3rem; transition:color .35s cubic-bezier(.22,1,.36,1)}
.companion-card:hover .pet-name{color:var(--terracotta-strong)}
.pet-breed{font-size:.76rem; color:var(--ink-faint); text-align:right; font-family:var(--font-body); font-weight:600}
.card-location{color:var(--ink-faint); font-size:.8rem; margin:8px 0 14px}
.view-details-btn{width:100%; padding:11px; border-radius:var(--radius-sm); border:1px solid var(--line); font-weight:700; font-size:.85rem; color:var(--ink)}
.view-details-btn:hover{border-color:var(--ink); background:var(--surface)}

/* ---------- Explainer / how it works ---------- */
.explainer{margin-top:0; padding:32px 0; display:grid; grid-template-columns:1fr 1.15fr; gap:40px; align-items:start}
.explainer h3{font-size:1.7rem; max-width:20ch}
.explainer > div > p{color:var(--ink-soft); margin-top:14px; max-width:44ch}
.reason{margin-top:18px; padding:16px 18px; background:var(--paper-warm); border-radius:var(--radius); font-size:.9rem}
.reason b{display:block; color:var(--terracotta-strong); margin-bottom:4px; font-size:.78rem; text-transform:uppercase; letter-spacing:.05em; font-family:var(--font-body); font-weight:700}
.steps{display:flex; flex-direction:column}
.step{display:flex; gap:16px; padding:20px 0; border-top:1px solid var(--line)}
.step:first-child{border-top:0; padding-top:0}
.step b{font-family:var(--font-display); font-size:1.3rem; color:var(--ink-faint); font-weight:600; flex-shrink:0; width:34px}
.step strong{display:block; font-family:var(--font-body); font-weight:700; font-size:.98rem; margin-bottom:4px}
.step span{color:var(--ink-soft); font-size:.88rem}

/* ---------- Demo ---------- */
.demo-intro{max-width:640px}
.demo-intro h3{font-size:1.9rem}
.demo-intro p{color:var(--ink-soft); margin-top:10px}
.demo-layout{display:grid; grid-template-columns:1fr 1.25fr; gap:22px; margin-top:28px; align-items:start}
.intake-card{padding:24px; border:1px solid var(--line); border-radius:var(--radius); background:var(--surface)}
.intake-card h4{font-size:1.05rem}
.intake-card .hint{color:var(--ink-soft); font-size:.83rem; margin:6px 0 20px}
.field{margin-bottom:18px; padding-bottom:18px; border-bottom:1px solid var(--line)}
.field:last-of-type{border-bottom:0; padding-bottom:0; margin-bottom:6px}
.field label{display:block; font-size:.8rem; font-weight:700; color:var(--ink); margin-bottom:9px}
.pill-group{display:flex; flex-wrap:wrap; gap:8px}
.pill{padding:9px 13px; border-radius:var(--radius-sm); border:1px solid var(--line); background:var(--paper); color:var(--ink-soft); font-weight:600; font-size:.82rem}
.pill.selected{background:var(--terracotta-tint); border-color:var(--terracotta); color:var(--terracotta-strong)}
.run-btn{width:100%; margin-top:4px; padding:14px; border-radius:var(--radius-sm); background:var(--ink); color:#fff; font-weight:700}
.run-btn:hover{background:#000}
.run-btn:disabled{background:var(--line); color:var(--ink-faint); cursor:not-allowed}

.results-panel{min-height:100%}
.results-empty{height:100%; min-height:260px; display:grid; place-items:center; text-align:center; color:var(--ink-soft); padding:28px; border:1px dashed var(--line); border-radius:var(--radius); font-size:.92rem}
.results-board{display:none; border:1px solid var(--line); border-radius:var(--radius); overflow:hidden}
.results-board.visible{display:block}
.board-summary{display:flex; background:var(--ink); color:#fff}
.board-stat{flex:1; padding:16px 18px}
.board-stat+.board-stat{border-left:1px solid rgba(255,255,255,.16)}
.board-stat b{display:block; font-family:var(--font-display); font-size:1.7rem; font-weight:600}
.board-stat span{font-size:.74rem; color:rgba(255,255,255,.6); font-weight:600; text-transform:uppercase; letter-spacing:.04em}
.match-list{display:flex; flex-direction:column}
.match-row{display:grid; grid-template-columns:auto 1fr auto auto; align-items:center; gap:14px; padding:14px 18px; border-top:1px solid var(--line)}
.match-row.is-you{background:var(--terracotta-tint)}
.match-avatar{width:38px;height:38px; border-radius:50%; background:var(--paper-warm); display:grid; place-items:center; flex-shrink:0; border:1px solid var(--line)}
.match-avatar svg{width:22px;height:22px}
.match-info b{font-family:var(--font-body); font-weight:700; font-size:.94rem}
.match-info p{margin:2px 0 0; color:var(--ink-faint); font-size:.78rem}
.match-person{font-size:.86rem; font-weight:700; text-align:right; min-width:110px}
.unmatched-row .match-person{color:var(--ink-faint); font-style:italic; font-weight:600}
.why-btn{padding:6px 0; font-size:.78rem; font-weight:700; color:var(--ink-soft); text-decoration:underline; text-underline-offset:3px}
.why-btn:hover{color:var(--ink)}
.why-detail{display:none; margin:0 18px 14px; padding:14px 16px; background:var(--paper-warm); border-radius:var(--radius-sm); font-size:.86rem}
.why-detail.open{display:block}
.why-detail .cite{display:block; margin-top:6px; font-size:.76rem; color:var(--ink-soft); font-weight:600}

/* ---------- Stamps ---------- */
.proof-stamp{
  display:inline-flex; align-items:center; gap:6px; border:2px solid currentColor; border-radius:3px;
  padding:5px 10px; font-weight:800; font-size:.68rem; letter-spacing:.09em; text-transform:uppercase;
  font-family:var(--font-body); animation:stampIn .16s ease-out;
}
.proof-stamp.matched,.proof-stamp.stable{color:var(--verified); background:var(--verified-tint)}
.proof-stamp.blocked,.proof-stamp.eliminated{color:var(--eliminated); background:var(--eliminated-tint)}
@keyframes stampIn{0%{opacity:0; transform:scale(1.3)}100%{opacity:1; transform:scale(1)}}

/* ---------- Tool grid ---------- */
.tool-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:16px; margin-top:22px}
.tool-card{padding:22px; border:1px solid var(--line); border-radius:var(--radius); background:var(--paper)}
.tool-card h4{font-size:1.05rem}
.tool-card .hint{color:var(--ink-soft); font-size:.84rem; margin:6px 0 16px; line-height:1.5}
.tool-card select{width:100%; padding:11px 12px; border:1px solid var(--line); border-radius:var(--radius-sm); background:var(--paper); font-weight:600; font-size:.85rem; margin-bottom:10px}
.swap-btn,.stability-btn{padding:11px 16px; border-radius:var(--radius-sm); background:var(--ink); color:#fff; font-weight:700; font-size:.86rem}
.swap-btn:hover,.stability-btn:hover{background:#000}
.swap-result{margin-top:14px; padding:13px 15px; border-radius:var(--radius-sm); font-size:.85rem; display:none; line-height:1.5}
.swap-result.show{display:block}
.swap-result.fail{background:var(--eliminated-tint); color:var(--ink)}
.swap-result.pass{background:var(--verified-tint); color:#215c3d}

.dial-row{display:flex; align-items:center; gap:14px; margin:14px 0 8px}
.dial-row input[type=range]{
  flex:1; -webkit-appearance:none; height:5px; border-radius:3px; background:var(--line); outline:none;
}
.dial-row input[type=range]::-webkit-slider-thumb{-webkit-appearance:none; width:20px;height:20px;border-radius:50%; background:var(--terracotta); border:3px solid #fff; box-shadow:0 0 0 1px var(--line); cursor:pointer}
.dial-value{font-family:var(--font-display); font-weight:700; min-width:28px; text-align:right; font-size:1.1rem}
.dial-note{font-size:.8rem; color:var(--ink-faint); margin-top:2px}
.dial-outcome{margin-top:14px; padding:13px 15px; border-radius:var(--radius-sm); background:var(--surface); border:1px solid var(--line); font-size:.85rem; line-height:1.6}

.unmatched-list{display:flex; flex-direction:column; gap:10px; margin-top:2px}
.unmatched-item{padding:12px 14px; border-radius:var(--radius-sm); background:var(--surface); border:1px solid var(--line); font-size:.85rem; display:flex; gap:10px; align-items:flex-start}
.unmatched-item .ua{width:30px;height:30px;border-radius:50%;background:var(--paper-warm);display:grid;place-items:center;flex-shrink:0;border:1px solid var(--line)}
.unmatched-item .ua svg{width:18px;height:18px}
.unmatched-item b{font-family:var(--font-body); display:block; margin-bottom:3px}

.impact-row{display:grid; grid-template-columns:1fr 1fr; gap:14px}
.impact-box{padding:16px; border-radius:var(--radius-sm); background:var(--surface); border:1px solid var(--line)}
.impact-box b{font-family:var(--font-display); font-size:1.8rem; display:block; font-weight:600}
.impact-box span{font-size:.78rem; color:var(--ink-soft)}
.impact-toggle{display:flex; gap:8px; margin-top:14px}
.impact-toggle button{flex:1; padding:9px; border-radius:var(--radius-sm); border:1px solid var(--line); color:var(--ink-soft); font-weight:700; font-size:.8rem}
.impact-toggle button.active{color:var(--terracotta-strong); border-color:var(--terracotta); background:var(--terracotta-tint)}
.impact-caveat{margin-top:12px; font-size:.76rem; color:var(--ink-faint); line-height:1.5}

.citation-panel{margin-top:20px; padding:26px; border-radius:var(--radius); background:var(--paper-warm)}
.citation-panel h4{font-size:1.05rem; margin-bottom:14px}
.citation-item{padding:12px 0; border-top:1px solid #E3D6C2; font-size:.87rem; color:var(--ink-soft); line-height:1.55}
.citation-item:first-of-type{border-top:0}
.citation-item b{color:var(--ink); font-weight:700}
.honesty-note{margin-top:16px; padding:14px 16px; border-radius:var(--radius-sm); background:#fff; border:1px solid var(--line); font-size:.84rem; line-height:1.55; color:var(--ink-soft)}
.honesty-note b{color:var(--ink)}

/* ---------- Footer ---------- */
.site-footer{margin-top:70px; padding:50px max(20px,calc((100vw - 1180px)/2)) 30px; background:var(--ink); color:#D9D3C6}
.footer-content{display:flex; justify-content:space-between; gap:50px}
.footer-brand{max-width:380px}
.footer-brand .nav-logo{color:#fff}
.footer-brand p{margin-top:10px; color:#B8B0A0; font-size:.9rem; line-height:1.6}
.footer-links{display:grid; grid-template-columns:repeat(3,1fr); gap:40px}
.link-column h4{font-size:.72rem; letter-spacing:.1em; text-transform:uppercase; color:var(--terracotta); margin:0 0 14px; font-family:var(--font-body); font-weight:700}
.link-column a{display:block; color:#B8B0A0; margin:9px 0; font-size:.88rem}
.link-column a:hover{color:#fff}
.footer-bottom{display:flex; justify-content:space-between; gap:20px; border-top:1px solid rgba(255,255,255,.14); margin-top:36px; padding-top:20px; color:#9A9385; font-size:.78rem}
.legal-links{display:flex; gap:18px}

/* ---------- Modal ---------- */
.modal-backdrop{position:fixed; inset:0; background:rgba(36,35,31,.5); display:none; place-items:center; z-index:50; padding:20px}
.modal-backdrop.open{display:grid}
.modal{width:min(540px,100%); padding:30px; border-radius:16px; background:#fff; box-shadow:var(--shadow-modal); position:relative; max-height:86vh; overflow:auto}
.close{position:absolute; right:18px; top:18px; width:34px;height:34px; border-radius:50%; background:var(--surface); border:1px solid var(--line); font-weight:700; font-size:18px}
.close:hover{background:var(--paper-warm)}
.modal .mini-pet{width:74px;height:74px; border-radius:50%; background:var(--paper-warm); display:grid; place-items:center; border:1px solid var(--line); overflow:hidden}
.modal .mini-pet img{width:100%; height:100%; object-fit:cover}
.modal h2{font-size:2rem; margin-top:16px}
.modal .reason{margin:16px 0}
.modal-actions{display:flex; gap:10px; margin-top:6px}

@media(max-width:900px){
  .nav-links{display:none}
  .hero-inner{grid-template-columns:1fr; gap:30px}
  .hero-copy-block{text-align:center; padding:0}
  .hero-copy{margin:0 auto}
  .hero-actions{justify-content:center}
  .hero-dog{justify-self:center; width:min(100%,360px); max-height:460px}
  .companion-grid{grid-template-columns:repeat(2,1fr)}
  .explainer{grid-template-columns:1fr; gap:20px}
  .demo-layout{grid-template-columns:1fr}
  .tool-grid{grid-template-columns:1fr}
  .footer-content{flex-direction:column}
}
@media(max-width:620px){
  .hero{padding-top:40px}
  .hero-inner{gap:24px}
  h1{font-size:2.4rem}
  .hero-copy{font-size:1rem}
  .hero-dog{min-height:320px; max-height:390px; border-radius:14px}
  .companion-grid{grid-template-columns:1fr}
  .section-head{flex-direction:column; align-items:flex-start}
  .footer-links{grid-template-columns:1fr 1fr}
  .footer-bottom{flex-direction:column; gap:10px}
  .impact-row{grid-template-columns:1fr}
  .match-row{grid-template-columns:auto 1fr; row-gap:6px}
  .match-person{grid-column:2; text-align:left}
  .why-btn{grid-column:2; text-align:left; padding-top:0}
}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
}
