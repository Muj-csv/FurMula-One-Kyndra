    <div class="footer-bottom">
      <p>© 2026 Kyndra. Simulated animals; real applicants. Prototype interface.</p>
      <div class="legal-links"><a href="#">Privacy</a><a href="#">Terms</a><a href="#">Accessibility</a></div>
    </div>
  </footer>

  <div class="modal-backdrop" id="modal">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <button class="close" id="closeModal" aria-label="Close">×</button>
      <div class="mini-pet" id="modalPet"></div>
      <h2 id="modal-title">Pet details</h2>
      <p id="modal-copy" style="color:var(--ink-soft); margin-top:10px;"></p>
      <div class="reason">
        <b>Match principle</b>
        This profile is part of a simulated cohort. Kyndra uses documented hard constraints before preferences are considered.
      </div>
      <div class="modal-actions">
        <button class="primary" id="startMatch">Continue to intake →</button>
        <button class="secondary" id="closeModal2">Close</button>
      </div>
    </div>
  </div>

  <!-- SVG SILHOUETTE SYMBOLS — real crafted assets, no emoji -->
