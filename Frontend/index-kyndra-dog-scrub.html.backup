          <div class="card-content">
            <div class="card-header"><h3 class="pet-name">Cinnamon</h3><span class="pet-breed">Holland Lop · 1 yr</span></div>
            <div class="card-location">Simulated shelter cohort</div>
            <button class="view-details-btn" data-pet="Cinnamon">View match requirements →</button>
          </div>
        </article>

        <article class="companion-card" data-type="dog" data-days="52">
          <div class="card-image-wrapper">
            <span class="status-tag">52 days waiting</span>
            <img class="card-photo" src="https://images.unsplash.com/photo-1580467277788-c6e040296602?auto=format&fit=crop&w=500&h=500&q=80" alt="Miniature Schnauzer dog, stand-in photo for Perro's simulated profile" loading="lazy">
            <span class="photo-credit">Sebastian Coman / Unsplash</span>
          </div>
          <div class="card-content">
            <div class="card-header"><h3 class="pet-name">Perro</h3><span class="pet-breed">Schnauzer · 5 yrs</span></div>
            <div class="card-location">Simulated shelter cohort</div>
